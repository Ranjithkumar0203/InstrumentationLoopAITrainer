# Base model used for this starter kit
BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Dataset paths
TRAIN_FILE=dataset/train.jsonl
VALIDATION_FILE=dataset/validation.jsonl

# Output directory for the LoRA adapter
OUTPUT_DIR=outputs/instrumentation-qwen-lora

# Adapter used by the inference UI (export this before starting FastAPI)
ADAPTER_PATH=outputs/instrumentation-qwen-lora

# Training settings
MAX_SEQ_LENGTH=2048
EPOCHS=2
LEARNING_RATE=2e-4
BATCH_SIZE=1
GRAD_ACCUM=8
LOGGING_STEPS=10
SAVE_STEPS=100

# LoRA settings
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
